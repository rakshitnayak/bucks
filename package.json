{
  "name": "bucks",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch --env-file=apps/api/.env apps/api/src/server.ts",
    "build": "tsc -b && vite build",
    "build:api": "tsc -p apps/api/tsconfig.json",
    "format": "npm run format:code && npm run format:sql",
    "format:code": "prettier --write \"src/**/*.{ts,tsx,css}\" \"apps/api/**/*.ts\" \"*.{json,ts}\" \"**/*.md\"",
    "format:sql": "for file in apps/api/migrations/*.sql; do sql-formatter --fix --language postgresql \"$file\"; done",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"apps/api/**/*.ts\" \"*.{json,ts}\" \"**/*.md\"",
    "test": "NODE_ENV=test tsx --env-file=apps/api/.env --test apps/api/test/api.test.ts",
    "preview": "vite preview",
    "db:migrate": "tsx --env-file=apps/api/.env apps/api/scripts/migrate.ts",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@types/pdfkit": "^0.17.6",
    "@vitejs/plugin-react": "latest",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.3",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/pg": "^8.23.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "prettier": "^3.9.6",
    "sql-formatter": "^15.8.2",
    "tsx": "^4.23.13",
    "typescript": "latest"
  }
}
